<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-center bg-white p-4 rounded shadow mb-6">
  <div class="text-xl font-semibold text-gray-800">
    👋 Welcome, <span class="text-blue-600"><%= data.user.full_name %></span>
  </div>
  <div class="flex items-center space-x-4 mt-4 md:mt-0">
    <div class="text-gray-700">👤 <%= data.user.username %></div>
      <button id="logout-btn" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1 rounded transition">
        Logout
      </button>
  </div>
</div>

<!-- Main Dashboard -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-6">
  <div class="md:col-span-2 space-y-6">

      <!-- OPTIONS -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6 mb-8 mx-auto">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">🌐 Choose your programming language</h2>
    <p class="text-gray-600 mb-6">You can select multiple languages to practice with:</p>
    <form id="language-form" class="flex flex-wrap gap-4">
      <% ['c++', 'nodejs'].forEach(lang => { %>
        <label class="flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 cursor-pointer transition hover:bg-green-50">
          <input type="checkbox" name="languages" value="<%= lang %>" class="hidden peer"
            <% if (data.user_selected_types.some(t => t.type_name.toLowerCase() === lang)) { %>checked<% } %> >
          <span class="peer-checked:bg-green-600 peer-checked:text-white px-3 py-1 rounded-full transition">
            <%= lang %>
          </span>
        </label>
      <% }) %>
    </form>
    <button id="languageSelect" class="mt-6 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl transition">
      ✅ Confirm choice
    </button>
  </div>


    <!-- Heatmap -->
    <div class="bg-white rounded-2xl shadow p-4">
      <h2 class="text-2xl font-bold flex items-center space-x-2 mb-4">
        <span class="text-yellow-500">📅</span>
        <span>Coding Calendar</span>
      </h2>
      <div id="months" style="display:flex;gap:2px;margin-left:30px;"></div>
      <div id="heatmap" style="display:flex;gap:2px;"></div>
    </div>

    <!-- Leaderboard -->
    <div class="bg-white rounded-2xl shadow p-4">
      <h2 class="text-2xl font-bold flex items-center space-x-2 mb-4">
        <span class="text-yellow-500">🏆</span>
        <span>Leaderboard</span>
      </h2>
      <ul id="leaderboard" class="space-y-3"></ul>
    </div>
  </div>

  <!-- Right side -->
  <div class="space-y-6">
    <div class="bg-white rounded-2xl shadow p-6 text-center">
      <h2 class="text-xl font-semibold mb-2">📈 Your progress</h2>
      <div class="gauge-card" id="score"></div>
    </div>
    <div class="bg-white rounded-2xl shadow p-4">
      <h2 class="text-2xl font-bold flex items-center space-x-2 mb-4">
        <span class="text-green-500">🎯</span>
        <span>Action Points</span>
      </h2>
      <ul id="action-points" class="list-disc list-inside space-y-2 text-gray-700"></ul>
    </div>
  </div>
</div>
