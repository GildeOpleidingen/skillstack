<div class="flex flex-col md:flex-row justify-between items-center bg-white p-4 rounded shadow mb-6">
  <div class="text-xl font-semibold text-gray-800">
    <%= data.category.icon %> <%= data.category.name %>
  </div>
  <div class="flex items-center space-x-4 mt-4 md:mt-0">
    <div class="text-gray-700">👤 <%= data.user.username %></div>
    <button id="logout-btn" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1 rounded transition">
      Logout
    </button>
  </div>
</div>

<div class="mx-auto mt-6 space-y-8 px-4">
  <div class="bg-white p-6 rounded-2xl shadow">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">🧠 <%= data.exercise.title %></h2>
      <span class="bg-blue-100 text-blue-800 text-sm font-semibold px-3 py-1 rounded-full">Score: <%= data.exercise.score %></span>
    </div>

    <div id="grading-banner" class="hidden text-yellow-700 text-sm mb-4">
      <div class="flex items-center gap-2 animate-pulse">
        <span class="spinner">⏳</span> Je inzending wordt nagekeken…
      </div>
      <p class="text-gray-400 text-xs">(verversen elke 5 sec)</p>
    </div>

    <div id="exercise-box">
      <div id="challenge-description" class="text-gray-700 mb-4 prose"></div>
      <form id="challengeForm" class="space-y-4">
        <input type="hidden" name="id" value="<%= data.exercise.id %>">           
        <div class="rounded-xl shadow-lg border border-gray-700 overflow-hidden">
          <textarea id="codeEditor" name="code"></textarea>
        </div>
        <button type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-semibold transition">
          🚀 Submit
        </button>
      </form>
    </div>
  </div>

  <div class="bg-white p-6 rounded-2xl shadow" id="terminal_container" style="display:none;">
    <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">💻 Terminal</h2>
    <div id="terminal" class="w-full h-32 md:h-40 lg:h-52 rounded-md bg-black text-green-300 font-mono p-2 overflow-y-auto"></div>
  </div>

  <div class="bg-white p-6 rounded-2xl shadow">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">📜 Submission History</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm border divide-y divide-gray-200">
        <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
          <tr>
            <th class="px-4 py-2 text-left">#</th>
            <th class="px-4 py-2 text-left">Result</th>              
            <th class="px-4 py-2 text-left">Submitted At</th>
            <th class="px-4 py-2 text-left">Graded At</th>
          </tr>
        </thead>
        <tbody id="submission-table-body" class="divide-y divide-gray-100 text-gray-800"></tbody>
      </table>
    </div>
  </div>
</div>

<div id="popup-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
  <div id="popup" class="bg-white p-8 rounded-2xl shadow-lg text-center w-full max-w-md mx-auto">
    <h2 class="text-3xl font-bold text-green-600">🎉 Quest Completed!</h2>
    <p class="text-lg text-gray-700 mt-2">You earned <span class="font-semibold" id="points"></span></p>
    <div class="mt-6 flex justify-center space-x-4">
      <button id="closeBtn" class="bg-gray-200 text-gray-800 px-4 py-2 rounded-xl hover:bg-gray-300">Close</button>
    </div>
  </div>
</div>
