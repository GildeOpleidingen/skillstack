<!-- Header -->
<div class="flex justify-between items-center bg-white p-4 rounded shadow mb-6">
  <div class="text-xl font-semibold text-gray-800">
    Categories administration
  </div>
  <button id="logout-btn" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1 rounded transition">
    Logout
  </button>
</div>
<!-- Add New Type Form -->
<form class="bg-white border border-gray-200 rounded-xl shadow-md p-6 mb-6">
  <h2 class="text-2xl font-bold text-gray-800 mb-4">
    Add New Type
  </h2>
  <div class="flex gap-2">
    <input type="text" name="name" placeholder="Type name"
      class="flex-1 p-2 border border-gray-300 rounded" required>
    <input type="text" name="icon" placeholder="Icon"
      class="w-20 p-2 border border-gray-300 rounded">
    <button type="submit"
      class="bg-purple-500 hover:bg-purple-600 text-white px-3 py-2 rounded">
      ➕ Add Type
    </button>
  </div>
</form>

<div class="space-y-10">
  <% data.types.forEach(type => { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6">
      <!-- Toggleable Type Panel Header -->
      <div class="flex items-center justify-between bg-gray-100 p-3 rounded-md cursor-pointer mb-4" data-panel="<%= type.id %>">
        <h2 class="text-2xl font-bold text-gray-800">
          <%= type.icon %> <%= type.name %>
        </h2>
        <span class="text-xl transition-transform duration-300" id="arrow-<%= type.id %>">▼</span>
      </div>

      <!-- Collapsible Content for Type -->
      <div id="panel-<%= type.id %>" class="pl-6 space-y-8 hidden">
        <!-- Main Categories -->
        <% data.categories
            .filter(cat => cat.type_id === type.id && cat.parent_id === 0)
            .sort((a, b) => a.sort_order - b.sort_order)
            .forEach(mainCat => { %>
          <div class="mb-8 border-l-4 border-blue-500 pl-3">
            <!-- Main Category -->
            <div class="flex items-center justify-between bg-gray-100 p-3 rounded-md">
              <div class="flex items-center gap-3 font-medium text-gray-800">
                <span><%= mainCat.icon %></span>
                <span><%= mainCat.name %></span>
                <% if (!mainCat.is_active) { %>
                  <span class="ml-2 text-xs bg-gray-300 text-gray-700 px-2 py-0.5 rounded">Hidden</span>
                <% } %>
              </div>
              <div class="flex gap-2">

                <!-- Toggle visibility -->
                <button data-id="<%= mainCat.id %>" class="toggle bg-yellow-500 hover:bg-yellow-600 text-white p-2 rounded" title="Toggle Visibility">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </button>

                <!-- Edit -->
                <!-- <button data-id="<%= mainCat.id %>" class="edit bg-blue-500 hover:bg-blue-600 text-white p-2 rounded" title="Edit">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5h2m-1 0v14m7-7H5" />
                  </svg>
                </button> -->

                <!-- Delete -->
                <!-- <button data-id="<%= mainCat.id %>" class="delete bg-red-500 hover:bg-red-600 text-white p-2 rounded" title="Delete">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button> -->
              </div>
            </div>

            <!-- Subcategories -->
            <ul id="subcategories-<%= mainCat.id %>" class="pl-6 mt-2 space-y-2 flex-direction: column">
              <% data.categories
                  .filter(sub => sub.parent_id === mainCat.id)
                  .sort((a, b) => a.sort_order - b.sort_order)
                  .forEach(sub => { %>
                <li class="flex items-center justify-between bg-gray-50 p-2 rounded border border-gray-200">
                  <div class="flex items-center gap-3">
                    <span><%= sub.icon %></span>
                    <span class="text-gray-700"><%= sub.name %></span>
                    <% if (!sub.is_active) { %>
                      <span class="ml-2 text-xs bg-gray-300 text-gray-700 px-2 py-0.5 rounded">Hidden</span>
                    <% } %>
                  </div>
                  <div class="flex gap-2">
                    <button data-id="<%= sub.id %>" class="move-up bg-gray-200 hover:bg-gray-300 px-2 py-1 rounded">⬆</button>
                    <button data-id="<%= sub.id %>" class="move-down bg-gray-200 hover:bg-gray-300 px-2 py-1 rounded">⬇</button>
                    <button data-id="<%= sub.id %>" class="toggle bg-yellow-500 hover:bg-yellow-600 text-white px-2 py-1 rounded">👁</button>
                    <button data-id="<%= sub.id %>" class="edit bg-blue-500 hover:bg-blue-600 text-white px-2 py-1 rounded">✎</button>
                    <button data-id="<%= sub.id %>" class="delete bg-red-500 hover:bg-red-600 text-white px-2 py-1 rounded">❌</button>
                  </div>
                </li>
              <% }) %>
            </ul>

            <!-- Add Subcategory Form -->
            <form class="add-subcategory-form mt-3 flex gap-2" data-parent="<%= mainCat.id %>">
              <input type="text" name="name" placeholder="Subcategory name"
                class="flex-1 p-2 border border-gray-300 rounded" required>
              <input type="text" name="icon" placeholder="Icon"
                class="w-20 p-2 border border-gray-300 rounded">
              <button type="submit"
                class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded">
                ➕
              </button>
            </form>
          </div>
        <% }) %>

        <!-- Add Main Category Form -->
        <form class="add-maincategory-form mt-4 flex gap-2" data-type="<%= type.id %>">
          <input type="text" name="name" placeholder="Main category name"
            class="flex-1 p-2 border border-gray-300 rounded" required>
          <input type="text" name="icon" placeholder="Icon"
            class="w-20 p-2 border border-gray-300 rounded">
          <button type="submit"
            class="bg-purple-500 hover:bg-purple-600 text-white px-3 py-2 rounded">
            ➕ Add Main Category
          </button>
        </form>
      </div>
    </div>
  <% }) %>
</div>