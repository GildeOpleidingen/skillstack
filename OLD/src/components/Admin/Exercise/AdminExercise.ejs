<!-- Header -->
<div class="flex justify-between items-center bg-white p-4 rounded shadow mb-6">
  <div class="text-xl font-semibold text-gray-800">
    Edit Exercise: <%= data.exercise.title %>
  </div>
  <button id="logout-btn" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1 rounded transition">
    Logout
  </button>
</div>

<div class="max-w-4xl mx-auto p-6">
  <!-- Exercise Metadata -->
  <form id="exercise-form" class="bg-white border border-gray-200 rounded-xl shadow-md p-6 mb-6">
    <input type="hidden" name="exercise_id" value="<%= data.exercise.id %>">

    <div>
      <label class="block text-sm font-medium mb-1">Order ID</label>
      <input type="text" name="sub_id" value="<%= data.exercise.sub_id %>" 
             class="w-full border rounded p-2" required>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Title</label>
      <input type="text" name="title" value="<%= data.exercise.title %>" 
             class="w-full border rounded p-2" required>
    </div>
  </form>

  <!-- Blocks Section -->
  <div  class="bg-white border border-gray-200 rounded-xl shadow-md p-6 mb-6">
  <h2 class="text-xl font-semibold mt-8 mb-4">Content Blocks</h2>

  <div id="blocks-container" class="space-y-4">
    <% data.blocks.forEach(block => { %>
      <div class="block-item border rounded p-4 bg-gray-50" data-id="<%= block.id %>">
        <div class="flex justify-between items-center mb-2">
          <span class="font-medium capitalize"><%= block.block_type %> block</span>
          <div class="flex gap-2">
            <button class="move-up text-gray-500">⬆</button>
            <button class="move-down text-gray-500">⬇</button>
            <button class="delete text-red-500">❌</button>
          </div>
        </div>
        <% if (block.block_type === "text") { %>
          <div class="quill-editor block-content w-full border rounded p-2 h-24"><%= block.content %></div>
        <% } else if (block.block_type === "image") { %>
          <input type="url" class="block-content w-full border rounded p-2" value="<%= block.content %>">
          <img src="<%= block.content %>" alt="preview" class="mt-2 max-h-40">
        <% } else if (block.block_type === "video") { %>
          <input type="url" class="block-content w-full border rounded p-2" value="<%= block.content %>">
          <div class="mt-2">
            <iframe src="<%= block.content %>" class="w-full h-48"></iframe>
          </div>
        <% } else if (block.block_type === "test") { %>
          <div class="block-content grid grid-cols-1 md:grid-cols-2 gap-2">
            <div>
              <label class="text-sm text-gray-600">Input:</label>
              <textarea class="test-input w-full border rounded p-2 h-24"><%= block.content.split("|||")[0] || "" %></textarea>
            </div>
            <div>
              <label class="text-sm text-gray-600">Output:</label>
              <textarea class="test-output w-full border rounded p-2 h-24"><%= block.content.split("|||")[1] || "" %></textarea>
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>

  <!-- Add Block Buttons -->
  <div class="mt-6 flex gap-2">
    <button data-type="text" class="add-block bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded">+ Text</button>
    <!-- <button data-type="image" class="add-block bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded">+ Image</button>
    <button data-type="video" class="add-block bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded">+ Video</button> -->
    <button data-type="test" class="add-block bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded">+ Test</button>
  </div>

  <div class="mt-8">
    <button id="save-exercise" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded">💾 Save</button>
  </div>
  </div>
</div>
