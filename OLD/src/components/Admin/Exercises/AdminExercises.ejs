<!-- Header -->
<div class="flex justify-between items-center bg-white p-4 rounded shadow mb-6">
  <div class="text-xl font-semibold text-gray-800">
    Exercises Administration
  </div>
  <button id="logout-btn" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1 rounded transition">
    Logout
  </button>
</div>

<div class="space-y-10">
  <% data.types.forEach(type => { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6">
      <!-- Toggleable Type Panel Header -->
      <div class="flex items-center justify-between bg-gray-100 p-3 rounded-md cursor-pointer mb-4" data-panel="<%= type.id %>">
        <h2 class="text-2xl font-bold text-gray-800">
          <%= type.icon %> <%= type.name %>
        </h2>
        <span class="text-xl transition-transform duration-300" id="arrow-<%= type.id %>">▼</span>
      </div>

      <!-- Collapsible Content for Type -->
      <div id="panel-<%= type.id %>" class="pl-6 space-y-8 hidden">
        <% data.categories
            .filter(cat => cat.type_id === type.id && cat.parent_id === 0)
            .sort((a, b) => a.sort_order - b.sort_order)
            .forEach(mainCat => { %>

          <div class="mb-8 border-l-4 border-blue-500 pl-3">
            <!-- Toggleable Main Category Header -->
            <div class="flex items-center justify-between bg-gray-100 p-3 rounded-md cursor-pointer mb-2" data-panel="<%= mainCat.id %>">
              <div class="flex items-center gap-3 font-medium text-gray-800">
                <span><%= mainCat.icon %></span>
                <span><%= mainCat.name %></span>
                <% if (!mainCat.is_active) { %>
                  <span class="ml-2 text-xs bg-gray-300 text-gray-700 px-2 py-0.5 rounded">Hidden</span>
                <% } %>
              </div>
              <span class="text-xl transition-transform duration-300" id="arrow-<%= mainCat.id %>">▼</span>
            </div>

            <!-- Collapsible Content for Main Category -->
            <div id="panel-<%= mainCat.id %>" class="pl-6 mt-2 space-y-4 hidden">

              <!-- Exercises List -->
              <ul id="exercises-<%= mainCat.id %>" class="space-y-2"></ul>

              <!-- Add Exercise Form -->
              <form class="add-exercise-form flex gap-2" data-category="<%= mainCat.id %>">
                <input type="text" name="name" placeholder="Exercise name"
                  class="flex-1 p-2 border border-gray-300 rounded" required>
                <!-- <input type="text" name="icon" placeholder="Icon"
                  class="w-20 p-2 border border-gray-300 rounded"> -->
                <button id="add_exercise"
                  class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded">
                  ➕ Add Exercise
                </button>
              </form>

              <!-- Subcategories -->
              <ul id="subcategories-<%= mainCat.id %>" class="space-y-2">
                <% data.categories
                    .filter(sub => sub.parent_id === mainCat.id)
                    .sort((a, b) => a.sort_order - b.sort_order)
                    .forEach(sub => { %>
                  <li>
                    <!-- Toggleable Subcategory Header -->
                    <div class="flex items-center justify-between bg-gray-50 p-2 rounded border border-gray-200 cursor-pointer mb-1" data-panel="<%= sub.id %>">
                      <div class="flex items-center gap-3">                       
                        <span class="text-gray-700"><%= sub.name %></span>
                        <% if (!sub.is_active) { %>
                          <span class="ml-2 text-xs bg-gray-300 text-gray-700 px-2 py-0.5 rounded">Hidden</span>
                        <% } %>
                      </div>
                      <span class="text-xl transition-transform duration-300" id="arrow-<%= sub.id %>">▼</span>
                    </div>

                    <!-- Collapsible Content for Subcategory -->
                    <div id="panel-<%= sub.id %>" class="pl-6 mt-1 space-y-2 hidden">
                      <!-- Exercises List -->
                      <ul id="exercises-<%= sub.id %>" class="space-y-2"></ul>

                      <!-- Add Exercise Form -->
                      <form class="add-exercise-form mt-3 flex gap-2" data-category="<%= sub.id %>">
                        <input type="text" name="name" placeholder="Exercise name"
                          class="flex-1 p-2 border border-gray-300 rounded" required>     
                        <button type="submit"
                          class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded">
                          ➕ Add Exercise
                        </button>
                      </form>
                    </div>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>
