<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeFolio Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <!-- xterm.js CSS -->
  <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm/css/xterm.css" /> -->
  <!-- CodeMirror CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">
</head>

<body>
  <div class="w-full min-h-screen bg-gray-100 main-container">
    <!-- Sidebar toggle for mobile (optional) -->
    <button onclick="toggleSidebar()"
      class="md:hidden fixed top-4 left-4 z-50 p-2 rounded-md bg-gray-800 text-white shadow-lg">
      ☰
    </button>
    <aside id="sidebar"
      class="w-64 bg-gray-900 text-white h-screen p-5 space-y-6 fixed top-0 left-0 transform md:translate-x-0 -translate-x-full transition-transform duration-300 ease-in-out z-40 shadow-xl sidebar">
    </aside>
    <div id="main" class="w-full pl-0 md:pl-64 transition-all duration-300 main"></div>
  </div>
  <!-- xterm.js JS -->
  <script src="https://cdn.jsdelivr.net/npm/xterm/lib/xterm.js"></script>
  <!-- CodeMirror JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/clike/clike.min.js"></script>  
  <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById("sidebar");
      sidebar.classList.toggle("-translate-x-full");
    } 
  </script>
</body>

</html>