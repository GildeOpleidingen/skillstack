# Base image with g++ 17
FROM ubuntu:22.04

# Install C++ compiler, shell, and basic tools
RUN apt-get update && apt-get install -y \
    g++ \
    libc6-dev \
    make \
    cmake \
    bash \    
    && rm -rf /var/lib/apt/lists/*

# Create sandbox directory
WORKDIR /app

# Optional: run as unprivileged user
RUN useradd -m grader
USER grader

# Default entrypoint that stays alive; commands can be exec'd as needed
CMD ["/bin/bash", "-lc", "while true; do sleep 3600; done"]