# Dockerfile.node-sandbox
FROM node:20-bullseye
WORKDIR /app
# Ensure a shell exists (optional but safe)
RUN apt-get update && apt-get install -y --no-install-recommends bash coreutils \
    && rm -rf /var/lib/apt/lists/*

# Optional: reduce privileges
RUN useradd -m grader
USER grader

CMD ["bash", "-lc", "while true; do sleep 3600; done"]
