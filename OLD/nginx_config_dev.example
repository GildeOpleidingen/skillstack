

server {
		listen 127.0.0.1;
		server_name localhost;

		# Substitute the directory below for the one you use.
		root /home/rayit/Dev/codefolio/public;
		
		# 🚨 Serve static assets first
		location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|html|txt)$ {
        	   try_files $uri =404;
    		}

		location / {
		  try_files $uri /index.html;
		}

		location /login {
		    include fastcgi_params;

    		    fastcgi_pass 127.0.0.1:9000;

    		    fastcgi_param SCRIPT_FILENAME /home/rayit/Dev/codefolio/cgi-bin/api.cgi;
		   
		}

                location /auth/github/callback {
                    include fastcgi_params;

                    fastcgi_pass 127.0.0.1:9000;

                    fastcgi_param SCRIPT_FILENAME /home/rayit/Dev/codefolio/cgi-bin/api.cgi;

                }



    		# Handle /api/
    		location /api/ {

		     	include fastcgi_params;
	    		fastcgi_pass 127.0.0.1:9000;
    			fastcgi_param SCRIPT_FILENAME /home/rayit/Dev/codefolio/cgi-bin/api.cgi;

		    	fastcgi_param REQUEST_METHOD $request_method;
			fastcgi_param CONTENT_TYPE   $content_type;
    			fastcgi_param CONTENT_LENGTH $content_length;
    		}

    		location = /favicon.ico {
        	    access_log off;
		    return 204;
		}
	}

